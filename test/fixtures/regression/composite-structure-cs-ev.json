{
  "kind":"composite-structure",
  "title":"EV charging station",
  "elements":[
    {"id":"station","type":"class","name":"ChargingStation",
     "ports":[{"id":"grid","name":"grid","type":"ACSupply"},{"id":"ocpp","name":"ocpp","type":"OcppLink"},{"id":"plug","name":"plug","type":"CCS2","multiplicity":"2"}],
     "parts":[
       {"id":"ctrl","name":"controller","type":"StationController","ports":[{"id":"cbus","name":"bus","type":"CanBus"}]},
       {"id":"meter","name":"meter","type":"EnergyMeter"},
       {"id":"rect","name":"rectifier","type":"PowerModule","multiplicity":"1..4"},
       {"id":"cable","name":"cable","type":"Cable","multiplicity":"2"},
       {"id":"hmi","name":"display","type":"TouchScreen"},
       {"id":"rfid","name":"reader","type":"RfidReader","multiplicity":"0..1"},
       {"id":"modem","name":"modem","type":"LteModem","aggregation":"shared"}
