[
  { "name": "duplicate node ID", "expect": { "code": "DUPLICATE_ID", "path": "/nodes/1/id" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "a", "type": "initial" }, { "id": "a", "type": "final" }] } },
  { "name": "inline lifeline ID clashes with a node", "expect": { "code": "DUPLICATE_ID", "path": "/nodes/1/lifelines/0/id" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" },
      { "id": "x", "type": "interaction", "name": "X", "lifelines": [{ "id": "s", "type": "A" }], "messages": [{ "from": "s", "to": "s", "name": "m" }] }] } },
  { "name": "flow to an unknown node", "expect": { "code": "MISSING_REFERENCE", "path": "/flows/0/to" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }], "flows": [{ "from": "s", "to": "nope" }] } },
  { "name": "inline message to a lifeline of another interaction", "expect": { "code": "MISSING_REFERENCE", "path": "/nodes/2/messages/0/to" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" },
      { "id": "x", "type": "interaction", "name": "X", "lifelines": [{ "id": "a", "type": "A" }], "messages": [{ "from": "a", "to": "a", "name": "m" }] },
      { "id": "y", "type": "interaction", "name": "Y", "lifelines": [{ "id": "b", "type": "B" }], "messages": [{ "from": "b", "to": "a", "name": "m" }] },
      { "id": "e", "type": "final" }],
      "flows": [{ "from": "s", "to": "x" }, { "from": "x", "to": "y" }, { "from": "y", "to": "e" }] } },
  { "name": "inline lifeline without name and type", "expect": { "code": "LIFELINE_WITHOUT_NAME", "path": "/nodes/1/lifelines/0" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" },
      { "id": "x", "type": "interaction", "name": "X", "lifelines": [{ "id": "a" }], "messages": [{ "from": "a", "to": "a", "name": "m" }] }, { "id": "e", "type": "final" }],
      "flows": [{ "from": "s", "to": "x" }, { "from": "x", "to": "e" }] } },
  { "name": "no initial node", "expect": { "code": "MISSING_INITIAL_NODE", "path": "/nodes" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "e", "type": "final" }] } },
  { "name": "two initial nodes", "expect": { "code": "MULTIPLE_INITIAL_NODES", "path": "/nodes/1" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "t", "type": "initial" }, { "id": "e", "type": "final" }],
      "flows": [{ "from": "s", "to": "e" }, { "from": "t", "to": "e" }] } },
  { "name": "flow into the initial node", "expect": { "code": "INITIAL_NODE_HAS_INCOMING", "path": "/flows/1/to" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "a", "type": "interaction-use", "name": "A" }],
      "flows": [{ "from": "s", "to": "a" }, { "from": "a", "to": "s" }] } },
  { "name": "flow out of an activity final", "expect": { "code": "FINAL_NODE_HAS_OUTGOING", "path": "/flows/1/from" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "e", "type": "final" }, { "id": "a", "type": "interaction-use", "name": "A" }, { "id": "f", "type": "flow-final" }],
      "flows": [{ "from": "s", "to": "e" }, { "from": "e", "to": "a" }, { "from": "a", "to": "f" }] } },
  { "name": "flow out of a flow final", "expect": { "code": "FINAL_NODE_HAS_OUTGOING", "path": "/flows/1/from" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "f", "type": "flow-final" }, { "id": "e", "type": "final" }],
      "flows": [{ "from": "s", "to": "f" }, { "from": "f", "to": "e" }] } },
  { "name": "flow from a node to itself", "expect": { "code": "SELF_FLOW", "path": "/flows/1/to" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "a", "type": "interaction-use", "name": "A" }, { "id": "e", "type": "final" }],
      "flows": [{ "from": "s", "to": "a" }, { "from": "a", "to": "a" }, { "from": "a", "to": "e" }] } },
  { "name": "the same flow twice", "expect": { "code": "DUPLICATE_FLOW", "path": "/flows/1" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "e", "type": "final" }],
      "flows": [{ "from": "s", "to": "e" }, { "from": "s", "to": "e" }] } },
  { "name": "decision with one branch", "expect": { "code": "INVALID_DECISION", "path": "/nodes/1" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "d", "type": "decision" }, { "id": "e", "type": "final" }],
      "flows": [{ "from": "s", "to": "d" }, { "from": "d", "to": "e", "guard": "x" }] } },
  { "name": "decision branch without a guard", "expect": { "code": "MISSING_GUARD", "path": "/flows/2" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "d", "type": "decision" }, { "id": "e", "type": "final" }, { "id": "f", "type": "flow-final" }],
      "flows": [{ "from": "s", "to": "d" }, { "from": "d", "to": "e", "guard": "x" }, { "from": "d", "to": "f" }] } },
  { "name": "two branches with the same guard", "expect": { "code": "DUPLICATE_GUARD", "path": "/flows/2/guard" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "d", "type": "decision" }, { "id": "e", "type": "final" }, { "id": "f", "type": "flow-final" }],
      "flows": [{ "from": "s", "to": "d" }, { "from": "d", "to": "e", "guard": "else" }, { "from": "d", "to": "f", "guard": "else" }] } },
  { "name": "guard on a flow that does not leave a decision", "expect": { "code": "GUARD_OUTSIDE_DECISION", "path": "/flows/0/guard" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "e", "type": "final" }],
      "flows": [{ "from": "s", "to": "e", "guard": "x" }] } },
  { "name": "merge with one incoming flow", "expect": { "code": "INVALID_MERGE", "path": "/nodes/1" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "m", "type": "merge" }, { "id": "e", "type": "final" }],
      "flows": [{ "from": "s", "to": "m" }, { "from": "m", "to": "e" }] } },
  { "name": "fork with one outgoing flow", "expect": { "code": "INVALID_FORK", "path": "/nodes/1" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "f", "type": "fork" }, { "id": "e", "type": "final" }],
      "flows": [{ "from": "s", "to": "f" }, { "from": "f", "to": "e" }] } },
  { "name": "join with two outgoing flows", "expect": { "code": "INVALID_JOIN", "path": "/nodes/4" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "f", "type": "fork" }, { "id": "a", "type": "interaction-use", "name": "A" }, { "id": "b", "type": "interaction-use", "name": "B" }, { "id": "j", "type": "join" }, { "id": "e", "type": "final" }, { "id": "g", "type": "flow-final" }],
      "flows": [{ "from": "s", "to": "f" }, { "from": "f", "to": "a" }, { "from": "f", "to": "b" }, { "from": "a", "to": "j" }, { "from": "b", "to": "j" }, { "from": "j", "to": "e" }, { "from": "j", "to": "g" }] } },
  { "name": "interaction use with two outgoing flows", "expect": { "code": "IMPLICIT_FORK", "path": "/nodes/1" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "a", "type": "interaction-use", "name": "A" }, { "id": "e", "type": "final" }, { "id": "f", "type": "flow-final" }],
      "flows": [{ "from": "s", "to": "a" }, { "from": "a", "to": "e" }, { "from": "a", "to": "f" }] } },
  { "name": "interaction use with two incoming flows", "expect": { "code": "IMPLICIT_JOIN", "path": "/nodes/3" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "d", "type": "decision" }, { "id": "b", "type": "interaction-use", "name": "B" }, { "id": "a", "type": "interaction-use", "name": "A" }, { "id": "e", "type": "final" }],
      "flows": [{ "from": "s", "to": "d" }, { "from": "d", "to": "b", "guard": "x" }, { "from": "d", "to": "a", "guard": "else" }, { "from": "b", "to": "a" }, { "from": "a", "to": "e" }] } },
  { "name": "interaction use that leads nowhere", "expect": { "code": "DEAD_END", "path": "/nodes/1" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "a", "type": "interaction-use", "name": "A" }],
      "flows": [{ "from": "s", "to": "a" }] } },
  { "name": "node unreachable from the initial node", "expect": { "code": "UNREACHABLE_NODE", "path": "/nodes/2" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "e", "type": "final" }, { "id": "e2", "type": "final" }],
      "flows": [{ "from": "s", "to": "e" }] } },
  { "name": "unknown node type", "expect": { "code": "SCHEMA_INVALID", "path": "/nodes/0" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "start" }] } },
  { "name": "name on a control node", "expect": { "code": "SCHEMA_INVALID", "path": "/nodes/0/name" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial", "name": "Start" }] } },
  { "name": "inline interaction without messages", "expect": { "code": "SCHEMA_INVALID", "path": "/nodes/0/messages" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "x", "type": "interaction", "name": "X", "lifelines": [{ "id": "a", "type": "A" }] }] } },
  { "name": "unknown inline message sort", "expect": { "code": "SCHEMA_INVALID", "path": "/nodes/0/messages/0/sort" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "x", "type": "interaction", "name": "X", "lifelines": [{ "id": "a", "type": "A" }], "messages": [{ "from": "a", "to": "a", "name": "m", "sort": "found" }] }] } },
  { "name": "missing nodes", "expect": { "code": "SCHEMA_INVALID", "path": "/nodes" },
    "doc": { "kind": "interaction-overview" } },
  { "name": "blank interaction use name", "expect": { "code": "INVALID_TEXT", "path": "/nodes/1/name" },
    "doc": { "kind": "interaction-overview", "nodes": [{ "id": "s", "type": "initial" }, { "id": "a", "type": "interaction-use", "name": " " }] } }
]
