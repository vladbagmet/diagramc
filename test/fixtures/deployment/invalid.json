[
  { "name": "duplicate element ID", "expect": { "code": "DUPLICATE_ID", "path": "/elements/1/id" },
    "doc": { "kind": "deployment", "elements": [{ "id": "a", "type": "node", "name": "A" }, { "id": "a", "type": "device", "name": "B" }] } },
  { "name": "nested ID clashes with a top-level ID", "expect": { "code": "DUPLICATE_ID", "path": "/elements/1/elements/0/id" },
    "doc": { "kind": "deployment", "elements": [{ "id": "a", "type": "artifact", "name": "a.jar" }, { "id": "n", "type": "node", "name": "N", "elements": [{ "id": "a", "type": "artifact", "name": "b.jar" }] }] } },
  { "name": "relationship ID clashes with an element ID", "expect": { "code": "DUPLICATE_ID", "path": "/relationships/0/id" },
    "doc": { "kind": "deployment", "elements": [{ "id": "a", "type": "node", "name": "A" }, { "id": "b", "type": "node", "name": "B" }], "relationships": [{ "id": "b", "type": "communicationPath", "from": "a", "to": "b" }] } },
  { "name": "communication path to an unknown node", "expect": { "code": "MISSING_REFERENCE", "path": "/relationships/0/to" },
    "doc": { "kind": "deployment", "elements": [{ "id": "a", "type": "node", "name": "A" }], "relationships": [{ "type": "communicationPath", "from": "a", "to": "nope" }] } },
  { "name": "communication path from an artifact", "expect": { "code": "INVALID_COMMUNICATION_PATH", "path": "/relationships/0/from" },
    "doc": { "kind": "deployment", "elements": [{ "id": "x", "type": "artifact", "name": "x.jar" }, { "id": "b", "type": "node", "name": "B" }], "relationships": [{ "type": "communicationPath", "from": "x", "to": "b" }] } },
  { "name": "communication path between a node and its nested node", "expect": { "code": "INVALID_COMMUNICATION_PATH", "path": "/relationships/0/to" },
    "doc": { "kind": "deployment", "elements": [{ "id": "a", "type": "node", "name": "A", "elements": [{ "id": "b", "type": "executionEnvironment", "name": "B" }] }], "relationships": [{ "type": "communicationPath", "from": "a", "to": "b" }] } },
  { "name": "communication path to itself", "expect": { "code": "SELF_CONNECTION", "path": "/relationships/0/to" },
    "doc": { "kind": "deployment", "elements": [{ "id": "a", "type": "node", "name": "A" }], "relationships": [{ "type": "communicationPath", "from": "a", "to": "a" }] } },
  { "name": "inverted multiplicity on a communication path", "expect": { "code": "INVALID_MULTIPLICITY", "path": "/relationships/0/toEnd/multiplicity" },
    "doc": { "kind": "deployment", "elements": [{ "id": "a", "type": "node", "name": "A" }, { "id": "b", "type": "node", "name": "B" }], "relationships": [{ "type": "communicationPath", "from": "a", "to": "b", "toEnd": { "multiplicity": "5..2" } }] } },
  { "name": "deploy a node", "expect": { "code": "INVALID_DEPLOYMENT", "path": "/relationships/0/from" },
    "doc": { "kind": "deployment", "elements": [{ "id": "a", "type": "node", "name": "A" }, { "id": "b", "type": "node", "name": "B" }], "relationships": [{ "type": "deploy", "from": "a", "to": "b" }] } },
  { "name": "deploy onto an artifact", "expect": { "code": "INVALID_DEPLOYMENT", "path": "/relationships/0/to" },
    "doc": { "kind": "deployment", "elements": [{ "id": "x", "type": "artifact", "name": "x.jar" }, { "id": "y", "type": "artifact", "name": "y.jar" }], "relationships": [{ "type": "deploy", "from": "x", "to": "y" }] } },
  { "name": "deploy an artifact already nested in the target", "expect": { "code": "INVALID_DEPLOYMENT", "path": "/relationships/0/to" },
    "doc": { "kind": "deployment", "elements": [{ "id": "n", "type": "node", "name": "N", "elements": [{ "id": "x", "type": "artifact", "name": "x.jar" }] }], "relationships": [{ "type": "deploy", "from": "x", "to": "n" }] } },
  { "name": "manifest from a node", "expect": { "code": "INVALID_MANIFEST", "path": "/relationships/0/from" },
    "doc": { "kind": "deployment", "elements": [{ "id": "n", "type": "node", "name": "N" }, { "id": "c", "type": "component", "name": "C" }], "relationships": [{ "type": "manifest", "from": "n", "to": "c" }] } },
  { "name": "manifest of a node", "expect": { "code": "INVALID_MANIFEST", "path": "/relationships/0/to" },
    "doc": { "kind": "deployment", "elements": [{ "id": "x", "type": "artifact", "name": "x.jar" }, { "id": "n", "type": "node", "name": "N" }], "relationships": [{ "type": "manifest", "from": "x", "to": "n" }] } },
  { "name": "dependency between a node and its nested artifact", "expect": { "code": "INVALID_DEPENDENCY", "path": "/relationships/0/to" },
    "doc": { "kind": "deployment", "elements": [{ "id": "n", "type": "node", "name": "N", "elements": [{ "id": "x", "type": "artifact", "name": "x.jar" }] }], "relationships": [{ "type": "dependency", "from": "n", "to": "x" }] } },
  { "name": "device inside an execution environment", "expect": { "code": "INVALID_NESTING", "path": "/elements/0/elements/0/type" },
    "doc": { "kind": "deployment", "elements": [{ "id": "e", "type": "executionEnvironment", "name": "JVM", "elements": [{ "id": "d", "type": "device", "name": "Disk" }] }] } },
  { "name": "relationship to a note", "expect": { "code": "NOTE_IN_RELATIONSHIP", "path": "/relationships/0/to" },
    "doc": { "kind": "deployment", "elements": [{ "id": "a", "type": "node", "name": "A" }, { "id": "n", "type": "note", "text": "x" }], "relationships": [{ "type": "dependency", "from": "a", "to": "n" }] } },
  { "name": "note attached to a note", "expect": { "code": "INVALID_ATTACHMENT", "path": "/elements/1/attachedTo/0" },
    "doc": { "kind": "deployment", "elements": [{ "id": "n1", "type": "note", "text": "x" }, { "id": "n2", "type": "note", "text": "y", "attachedTo": ["n1"] }] } },
  { "name": "note attached to an unknown element", "expect": { "code": "MISSING_REFERENCE", "path": "/elements/0/attachedTo/0" },
    "doc": { "kind": "deployment", "elements": [{ "id": "n", "type": "note", "text": "x", "attachedTo": ["nope"] }] } },
  { "name": "nesting deeper than four levels", "expect": { "code": "NESTING_TOO_DEEP", "path": "/elements/0/elements/0/elements/0/elements/0/elements/0/elements/0" },
    "doc": { "kind": "deployment", "elements": [{ "id": "a", "type": "node", "name": "A", "elements": [{ "id": "b", "type": "node", "name": "B", "elements": [{ "id": "c", "type": "device", "name": "C", "elements": [{ "id": "d", "type": "executionEnvironment", "name": "D", "elements": [{ "id": "e", "type": "executionEnvironment", "name": "E", "elements": [{ "id": "f", "type": "artifact", "name": "f.jar" }] }] }] }] }] }] } },
  { "name": "unknown node property", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/color" },
    "doc": { "kind": "deployment", "elements": [{ "id": "a", "type": "node", "name": "A", "color": "red" }] } },
  { "name": "artifact with nested elements", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/elements" },
    "doc": { "kind": "deployment", "elements": [{ "id": "x", "type": "artifact", "name": "x.jar", "elements": [] }] } },
  { "name": "note nested in a node", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/elements/0/type" },
    "doc": { "kind": "deployment", "elements": [{ "id": "a", "type": "node", "name": "A", "elements": [{ "id": "n", "type": "note", "text": "x" }] }] } },
  { "name": "role on a communication path end", "expect": { "code": "SCHEMA_INVALID", "path": "/relationships/0/toEnd/role" },
    "doc": { "kind": "deployment", "elements": [{ "id": "a", "type": "node", "name": "A" }, { "id": "b", "type": "node", "name": "B" }], "relationships": [{ "type": "communicationPath", "from": "a", "to": "b", "toEnd": { "role": "x" } }] } },
  { "name": "protocol on a deploy dependency", "expect": { "code": "SCHEMA_INVALID", "path": "/relationships/0/protocol" },
    "doc": { "kind": "deployment", "elements": [{ "id": "x", "type": "artifact", "name": "x.jar" }, { "id": "b", "type": "node", "name": "B" }], "relationships": [{ "type": "deploy", "from": "x", "to": "b", "protocol": "ssh" }] } },
  { "name": "unknown relationship type", "expect": { "code": "SCHEMA_INVALID", "path": "/relationships/0/type" },
    "doc": { "kind": "deployment", "elements": [{ "id": "a", "type": "node", "name": "A" }, { "id": "b", "type": "node", "name": "B" }], "relationships": [{ "type": "association", "from": "a", "to": "b" }] } },
  { "name": "unknown property on a deployment specification property", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/properties/0/unit" },
    "doc": { "kind": "deployment", "elements": [{ "id": "s", "type": "deploymentSpecification", "name": "s.xml", "properties": [{ "name": "x", "unit": "ms" }] }] } },
  { "name": "blank node name", "expect": { "code": "INVALID_TEXT", "path": "/elements/0/name" },
    "doc": { "kind": "deployment", "elements": [{ "id": "a", "type": "node", "name": " " }] } }
]
