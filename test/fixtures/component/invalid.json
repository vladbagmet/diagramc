[
  { "name": "duplicate element ID", "expect": { "code": "DUPLICATE_ID", "path": "/elements/1/id" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A" }, { "id": "a", "type": "component", "name": "B" }] } },
  { "name": "port ID clashes with an element ID", "expect": { "code": "DUPLICATE_ID", "path": "/elements/1/ports/0/id" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A" }, { "id": "b", "type": "component", "name": "B", "ports": [{ "id": "a" }] }] } },
  { "name": "nested element ID clashes with a top-level ID", "expect": { "code": "DUPLICATE_ID", "path": "/elements/1/elements/0/id" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A" }, { "id": "b", "type": "component", "name": "B", "elements": [{ "id": "a", "type": "class", "name": "C" }] }] } },
  { "name": "relationship ID clashes with an element ID", "expect": { "code": "DUPLICATE_ID", "path": "/relationships/0/id" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A" }, { "id": "b", "type": "component", "name": "B" }], "relationships": [{ "id": "a", "type": "dependency", "from": "a", "to": "b" }] } },
  { "name": "provides an unknown interface", "expect": { "code": "MISSING_REFERENCE", "path": "/elements/0/provides/0" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "provides": ["nope"] }] } },
  { "name": "port requires an unknown interface", "expect": { "code": "MISSING_REFERENCE", "path": "/elements/0/ports/0/requires/0" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "ports": [{ "id": "p", "requires": ["nope"] }] }] } },
  { "name": "provides a component instead of an interface", "expect": { "code": "NOT_AN_INTERFACE", "path": "/elements/0/provides/0" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "provides": ["b"] }, { "id": "b", "type": "component", "name": "B" }] } },
  { "name": "interface listed twice", "expect": { "code": "DUPLICATE_INTERFACE", "path": "/elements/0/requires/1" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "requires": ["i", "i"] }, { "id": "i", "type": "interface", "name": "I" }] } },
  { "name": "assembly to an unknown provider", "expect": { "code": "MISSING_REFERENCE", "path": "/relationships/0/to" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "requires": ["i"] }, { "id": "i", "type": "interface", "name": "I" }], "relationships": [{ "type": "assembly", "from": "a", "to": "missing", "interface": "i" }] } },
  { "name": "assembly with an unknown interface", "expect": { "code": "MISSING_REFERENCE", "path": "/relationships/0/interface" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A" }, { "id": "b", "type": "component", "name": "B" }], "relationships": [{ "type": "assembly", "from": "a", "to": "b", "interface": "nope" }] } },
  { "name": "assembly interface is not an interface", "expect": { "code": "NOT_AN_INTERFACE", "path": "/relationships/0/interface" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A" }, { "id": "b", "type": "component", "name": "B" }], "relationships": [{ "type": "assembly", "from": "a", "to": "b", "interface": "b" }] } },
  { "name": "assembly from a side that does not require the interface", "expect": { "code": "ASSEMBLY_MISMATCH", "path": "/relationships/0/from" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A" }, { "id": "b", "type": "component", "name": "B", "provides": ["i"] }, { "id": "i", "type": "interface", "name": "I" }], "relationships": [{ "type": "assembly", "from": "a", "to": "b", "interface": "i" }] } },
  { "name": "assembly to a side that requires instead of provides", "expect": { "code": "ASSEMBLY_MISMATCH", "path": "/relationships/0/to" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "ports": [{ "id": "pa", "requires": ["i"] }] }, { "id": "b", "type": "component", "name": "B", "ports": [{ "id": "pb", "requires": ["i"] }] }, { "id": "i", "type": "interface", "name": "I" }], "relationships": [{ "type": "assembly", "from": "pa", "to": "pb", "interface": "i" }] } },
  { "name": "assembly of a different interface than the one provided", "expect": { "code": "ASSEMBLY_MISMATCH", "path": "/relationships/0/to" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "requires": ["i"] }, { "id": "b", "type": "component", "name": "B", "provides": ["j"] }, { "id": "i", "type": "interface", "name": "I" }, { "id": "j", "type": "interface", "name": "J" }], "relationships": [{ "type": "assembly", "from": "a", "to": "b", "interface": "i" }] } },
  { "name": "assembly from an artifact", "expect": { "code": "INVALID_CONNECTOR_END", "path": "/relationships/0/from" },
    "doc": { "kind": "component", "elements": [{ "id": "x", "type": "artifact", "name": "x.jar" }, { "id": "b", "type": "component", "name": "B", "provides": ["i"] }, { "id": "i", "type": "interface", "name": "I" }], "relationships": [{ "type": "assembly", "from": "x", "to": "b", "interface": "i" }] } },
  { "name": "assembly between two ports of one component", "expect": { "code": "SELF_CONNECTION", "path": "/relationships/0/to" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "ports": [{ "id": "p", "requires": ["i"] }, { "id": "q", "provides": ["i"] }] }, { "id": "i", "type": "interface", "name": "I" }], "relationships": [{ "type": "assembly", "from": "p", "to": "q", "interface": "i" }] } },
  { "name": "assembly between a component and its own part", "expect": { "code": "INVALID_ASSEMBLY", "path": "/relationships/0/to" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "requires": ["i"], "elements": [{ "id": "b", "type": "component", "name": "B", "provides": ["i"] }] }, { "id": "i", "type": "interface", "name": "I" }], "relationships": [{ "type": "assembly", "from": "a", "to": "b", "interface": "i" }] } },
  { "name": "delegation between siblings", "expect": { "code": "DELEGATION_OUTSIDE_CONTAINER", "path": "/relationships/0/to" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "ports": [{ "id": "p" }] }, { "id": "b", "type": "component", "name": "B" }], "relationships": [{ "type": "delegation", "from": "p", "to": "b" }] } },
  { "name": "delegation skipping a containment level", "expect": { "code": "DELEGATION_OUTSIDE_CONTAINER", "path": "/relationships/0/to" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "ports": [{ "id": "p" }], "elements": [{ "id": "b", "type": "component", "name": "B", "elements": [{ "id": "c", "type": "component", "name": "C" }] }] }], "relationships": [{ "type": "delegation", "from": "p", "to": "c" }] } },
  { "name": "delegation from the component itself instead of a port", "expect": { "code": "INVALID_DELEGATION", "path": "/relationships/0/from" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "elements": [{ "id": "b", "type": "component", "name": "B" }] }], "relationships": [{ "type": "delegation", "from": "a", "to": "b" }] } },
  { "name": "delegation between ends with no interface in common", "expect": { "code": "DELEGATION_INTERFACE_MISMATCH", "path": "/relationships/0/to" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "ports": [{ "id": "p", "provides": ["i"] }], "elements": [{ "id": "b", "type": "component", "name": "B", "ports": [{ "id": "q", "provides": ["j"] }] }] }, { "id": "i", "type": "interface", "name": "I" }, { "id": "j", "type": "interface", "name": "J" }], "relationships": [{ "type": "delegation", "from": "p", "to": "q" }] } },
  { "name": "delegation to an interface", "expect": { "code": "INVALID_CONNECTOR_END", "path": "/relationships/0/to" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "ports": [{ "id": "p" }] }, { "id": "i", "type": "interface", "name": "I" }], "relationships": [{ "type": "delegation", "from": "p", "to": "i" }] } },
  { "name": "realization of a component", "expect": { "code": "INVALID_REALIZATION", "path": "/relationships/0/to" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A" }, { "id": "b", "type": "component", "name": "B" }], "relationships": [{ "type": "realization", "from": "a", "to": "b" }] } },
  { "name": "realization by an artifact", "expect": { "code": "INVALID_REALIZATION", "path": "/relationships/0/from" },
    "doc": { "kind": "component", "elements": [{ "id": "x", "type": "artifact", "name": "x.jar" }, { "id": "i", "type": "interface", "name": "I" }], "relationships": [{ "type": "realization", "from": "x", "to": "i" }] } },
  { "name": "usage of a component", "expect": { "code": "INVALID_USAGE", "path": "/relationships/0/to" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A" }, { "id": "b", "type": "component", "name": "B" }], "relationships": [{ "type": "usage", "from": "a", "to": "b" }] } },
  { "name": "manifest from a component", "expect": { "code": "INVALID_MANIFEST", "path": "/relationships/0/from" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A" }, { "id": "b", "type": "component", "name": "B" }], "relationships": [{ "type": "manifest", "from": "a", "to": "b" }] } },
  { "name": "manifest of an interface", "expect": { "code": "INVALID_MANIFEST", "path": "/relationships/0/to" },
    "doc": { "kind": "component", "elements": [{ "id": "x", "type": "artifact", "name": "x.jar" }, { "id": "i", "type": "interface", "name": "I" }], "relationships": [{ "type": "manifest", "from": "x", "to": "i" }] } },
  { "name": "dependency from a component to its own port", "expect": { "code": "SELF_CONNECTION", "path": "/relationships/0/to" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "ports": [{ "id": "p" }] }], "relationships": [{ "type": "dependency", "from": "a", "to": "p" }] } },
  { "name": "relationship to a note", "expect": { "code": "NOTE_IN_RELATIONSHIP", "path": "/relationships/0/from" },
    "doc": { "kind": "component", "elements": [{ "id": "n", "type": "note", "text": "x" }, { "id": "a", "type": "component", "name": "A" }], "relationships": [{ "type": "dependency", "from": "n", "to": "a" }] } },
  { "name": "note attached to a note", "expect": { "code": "INVALID_ATTACHMENT", "path": "/elements/1/attachedTo/0" },
    "doc": { "kind": "component", "elements": [{ "id": "n1", "type": "note", "text": "x" }, { "id": "n2", "type": "note", "text": "y", "attachedTo": ["n1"] }] } },
  { "name": "note attached to a port", "expect": { "code": "INVALID_ATTACHMENT", "path": "/elements/1/attachedTo/0" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "ports": [{ "id": "p" }] }, { "id": "n", "type": "note", "text": "x", "attachedTo": ["p"] }] } },
  { "name": "note attached to an unknown element", "expect": { "code": "MISSING_REFERENCE", "path": "/elements/0/attachedTo/0" },
    "doc": { "kind": "component", "elements": [{ "id": "n", "type": "note", "text": "x", "attachedTo": ["nope"] }] } },
  { "name": "nesting deeper than four levels", "expect": { "code": "NESTING_TOO_DEEP", "path": "/elements/0/elements/0/elements/0/elements/0/elements/0/elements/0" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "elements": [{ "id": "b", "type": "component", "name": "B", "elements": [{ "id": "c", "type": "component", "name": "C", "elements": [{ "id": "d", "type": "component", "name": "D", "elements": [{ "id": "e", "type": "component", "name": "E", "elements": [{ "id": "f", "type": "class", "name": "F" }] }] }] }] }] }] } },
  { "name": "unknown port property", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/ports/0/color" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "ports": [{ "id": "p", "color": "red" }] }] } },
  { "name": "ports on an interface", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/ports" },
    "doc": { "kind": "component", "elements": [{ "id": "i", "type": "interface", "name": "I", "ports": [] }] } },
  { "name": "interface nested in a component", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/elements/0/type" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "elements": [{ "id": "i", "type": "interface", "name": "I" }] }] } },
  { "name": "assembly without an interface", "expect": { "code": "SCHEMA_INVALID", "path": "/relationships/0/interface" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A" }, { "id": "b", "type": "component", "name": "B" }], "relationships": [{ "type": "assembly", "from": "a", "to": "b" }] } },
  { "name": "unknown relationship type", "expect": { "code": "SCHEMA_INVALID", "path": "/relationships/0/type" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A" }, { "id": "b", "type": "component", "name": "B" }], "relationships": [{ "type": "association", "from": "a", "to": "b" }] } },
  { "name": "multi-line port name", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/ports/0/name" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "A", "ports": [{ "id": "p", "name": "a\nb" }] }] } },
  { "name": "blank component name", "expect": { "code": "INVALID_TEXT", "path": "/elements/0/name" },
    "doc": { "kind": "component", "elements": [{ "id": "a", "type": "component", "name": "   " }] } }
]
