[
  { "name": "duplicate element ID", "expect": { "code": "DUPLICATE_ID", "path": "/elements/1/id" },
    "doc": { "kind": "object", "elements": [{ "id": "a", "type": "instance", "name": "a" }, { "id": "a", "type": "instance", "name": "b" }] } },
  { "name": "link ID clashes with an element ID", "expect": { "code": "DUPLICATE_ID", "path": "/relationships/0/id" },
    "doc": { "kind": "object", "elements": [{ "id": "a", "type": "instance", "name": "a" }, { "id": "b", "type": "instance", "name": "b" }], "relationships": [{ "id": "a", "type": "link", "from": "a", "to": "b" }] } },
  { "name": "link to an unknown instance", "expect": { "code": "MISSING_REFERENCE", "path": "/relationships/0/to" },
    "doc": { "kind": "object", "elements": [{ "id": "a", "type": "instance", "name": "a" }], "relationships": [{ "type": "link", "from": "a", "to": "ghost" }] } },
  { "name": "link from an unknown instance", "expect": { "code": "MISSING_REFERENCE", "path": "/relationships/0/from" },
    "doc": { "kind": "object", "elements": [{ "id": "a", "type": "instance", "name": "a" }], "relationships": [{ "type": "link", "from": "ghost", "to": "a" }] } },
  { "name": "unknown note attachment", "expect": { "code": "MISSING_REFERENCE", "path": "/elements/1/attachedTo/0" },
    "doc": { "kind": "object", "elements": [{ "id": "a", "type": "instance", "name": "a" }, { "id": "n", "type": "note", "text": "x", "attachedTo": ["ghost"] }] } },
  { "name": "link to a note", "expect": { "code": "NOTE_IN_RELATIONSHIP", "path": "/relationships/0/to" },
    "doc": { "kind": "object", "elements": [{ "id": "a", "type": "instance", "name": "a" }, { "id": "n", "type": "note", "text": "x" }], "relationships": [{ "type": "link", "from": "a", "to": "n" }] } },
  { "name": "note attached to a note", "expect": { "code": "INVALID_ATTACHMENT", "path": "/elements/1/attachedTo/0" },
    "doc": { "kind": "object", "elements": [{ "id": "n1", "type": "note", "text": "x" }, { "id": "n2", "type": "note", "text": "y", "attachedTo": ["n1"] }] } },
  { "name": "instance without name and classifier", "expect": { "code": "UNNAMED_UNTYPED_INSTANCE", "path": "/elements/0" },
    "doc": { "kind": "object", "elements": [{ "id": "a", "type": "instance", "slots": [{ "feature": "x", "value": "1" }] }] } },
  { "name": "undeclared classifier", "expect": { "code": "UNKNOWN_CLASSIFIER", "path": "/elements/0/classifier" },
    "doc": { "kind": "object", "classifiers": [{ "name": "Order" }], "elements": [{ "id": "a", "type": "instance", "name": "a", "classifier": "Ordr" }] } },
  { "name": "slot for an undeclared attribute", "expect": { "code": "UNKNOWN_FEATURE", "path": "/elements/0/slots/0/feature" },
    "doc": { "kind": "object", "classifiers": [{ "name": "Order", "attributes": ["total"] }], "elements": [{ "id": "a", "type": "instance", "classifier": "Order", "slots": [{ "feature": "totl", "value": "1" }] }] } },
  { "name": "two slots for one feature", "expect": { "code": "DUPLICATE_SLOT", "path": "/elements/0/slots/1/feature" },
    "doc": { "kind": "object", "elements": [{ "id": "a", "type": "instance", "name": "a", "slots": [{ "feature": "x", "value": "1" }, { "feature": "x", "value": "2" }] }] } },
  { "name": "classifier declared twice", "expect": { "code": "DUPLICATE_CLASSIFIER", "path": "/classifiers/1/name" },
    "doc": { "kind": "object", "classifiers": [{ "name": "Order" }, { "name": "Order" }], "elements": [{ "id": "a", "type": "instance", "classifier": "Order" }] } },
  { "name": "attribute declared twice", "expect": { "code": "DUPLICATE_MEMBER", "path": "/classifiers/0/attributes/1" },
    "doc": { "kind": "object", "classifiers": [{ "name": "Order", "attributes": ["x", "x"] }], "elements": [{ "id": "a", "type": "instance", "classifier": "Order" }] } },
  { "name": "multiplicity on a link end", "expect": { "code": "SCHEMA_INVALID", "path": "/relationships/0/toEnd/multiplicity" },
    "doc": { "kind": "object", "elements": [{ "id": "a", "type": "instance", "name": "a" }, { "id": "b", "type": "instance", "name": "b" }], "relationships": [{ "type": "link", "from": "a", "to": "b", "toEnd": { "multiplicity": "1" } }] } },
  { "name": "slot without a value", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/slots/0/value" },
    "doc": { "kind": "object", "elements": [{ "id": "a", "type": "instance", "name": "a", "slots": [{ "feature": "x" }] }] } },
  { "name": "class element in an object diagram", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0" },
    "doc": { "kind": "object", "elements": [{ "id": "a", "type": "class", "name": "A" }] } },
  { "name": "association instead of a link", "expect": { "code": "SCHEMA_INVALID", "path": "/relationships/0/type" },
    "doc": { "kind": "object", "elements": [{ "id": "a", "type": "instance", "name": "a" }, { "id": "b", "type": "instance", "name": "b" }], "relationships": [{ "type": "association", "from": "a", "to": "b" }] } },
  { "name": "unknown property on a classifier declaration", "expect": { "code": "SCHEMA_INVALID", "path": "/classifiers/0/operations" },
    "doc": { "kind": "object", "classifiers": [{ "name": "Order", "operations": [] }], "elements": [{ "id": "a", "type": "instance", "classifier": "Order" }] } },
  { "name": "multi-line slot value", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/slots/0/value" },
    "doc": { "kind": "object", "elements": [{ "id": "a", "type": "instance", "name": "a", "slots": [{ "feature": "x", "value": "1\n2" }] }] } },
  { "name": "bidi override in a slot value", "expect": { "code": "INVALID_TEXT", "path": "/elements/0/slots/0/value" },
    "doc": { "kind": "object", "elements": [{ "id": "a", "type": "instance", "name": "a", "slots": [{ "feature": "x", "value": "a‮b" }] }] } },
  { "name": "blank instance name", "expect": { "code": "INVALID_TEXT", "path": "/elements/0/name" },
    "doc": { "kind": "object", "elements": [{ "id": "a", "type": "instance", "name": " " }] } }
]
