  { "name": "connector to the class itself", "expect": { "code": "INVALID_CONNECTOR_END", "path": "/relationships/0/to" },
    "doc": { "kind": "composite-structure", "elements": [{ "id": "c", "type": "class", "name": "C", "parts": [{ "id": "a", "name": "a" }] }], "relationships": [{ "type": "connector", "from": "a", "to": "c" }] } },
  { "name": "connector across two structured classes", "expect": { "code": "CONNECTOR_CONTEXT", "path": "/relationships/0/to" },
    "doc": { "kind": "composite-structure", "elements": [{ "id": "c", "type": "class", "name": "C", "parts": [{ "id": "a", "name": "a" }] }, { "id": "d", "type": "class", "name": "D", "parts": [{ "id": "b", "name": "b" }] }], "relationships": [{ "type": "connector", "from": "a", "to": "b" }] } },
  { "name": "connector from a part to a collaboration role", "expect": { "code": "CONNECTOR_CONTEXT", "path": "/relationships/0/to" },
    "doc": { "kind": "composite-structure", "elements": [{ "id": "c", "type": "class", "name": "C", "parts": [{ "id": "a", "name": "a" }] }, { "id": "k", "type": "collaboration", "name": "K", "roles": [{ "id": "r", "name": "r" }] }], "relationships": [{ "type": "connector", "from": "a", "to": "r" }] } },
  { "name": "connector from a part to its own port", "expect": { "code": "SELF_CONNECTION", "path": "/relationships/0/to" },
    "doc": { "kind": "composite-structure", "elements": [{ "id": "c", "type": "class", "name": "C", "parts": [{ "id": "a", "name": "a", "ports": [{ "id": "p" }] }] }], "relationships": [{ "type": "connector", "from": "a", "to": "p" }] } },
  { "name": "connector into a part's internal structure not through a port", "expect": { "code": "INVALID_CONNECTOR_END", "path": "/relationships/0/from" },
    "doc": { "kind": "composite-structure", "elements": [{ "id": "c", "type": "class", "name": "C", "parts": [{ "id": "a", "name": "a", "parts": [{ "id": "b", "name": "b" }] }] }], "relationships": [{ "type": "connector", "from": "a", "to": "b" }] } },
  { "name": "inverted part multiplicity", "expect": { "code": "INVALID_MULTIPLICITY", "path": "/elements/0/parts/0/multiplicity" },
