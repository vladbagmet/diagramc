  { "name": "aggregation value that is not a UML aggregation kind", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/parts/0/aggregation" },
    "doc": { "kind": "composite-structure", "elements": [{ "id": "c", "type": "class", "name": "C", "parts": [{ "id": "a", "name": "a", "aggregation": "weak" }] }] } },
  { "name": "part without a name", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/parts/0/name" },
