[
  { "name": "duplicate part ID", "expect": { "code": "DUPLICATE_ID", "path": "/elements/0/parts/1/id" },
    "doc": { "kind": "composite-structure", "elements": [{ "id": "c", "type": "class", "name": "C", "parts": [{ "id": "p", "name": "a" }, { "id": "p", "name": "b" }] }] } },
  { "name": "port ID clashes with the class ID", "expect": { "code": "DUPLICATE_ID", "path": "/elements/0/ports/0/id" },
    "doc": { "kind": "composite-structure", "elements": [{ "id": "c", "type": "class", "name": "C", "ports": [{ "id": "c" }] }] } },
  { "name": "role ID clashes with a part ID", "expect": { "code": "DUPLICATE_ID", "path": "/elements/1/roles/0/id" },
