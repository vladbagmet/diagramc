  { "name": "binding a role twice", "expect": { "code": "DUPLICATE_BINDING", "path": "/elements/0/collaborationUses/0/bindings/1/role" },
    "doc": { "kind": "composite-structure", "elements": [
      { "id": "c", "type": "class", "name": "C", "parts": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "collaborationUses": [{ "id": "u", "name": "u", "collaboration": "k", "bindings": [{ "role": "r", "part": "a" }, { "role": "r", "part": "b" }] }] },
      { "id": "k", "type": "collaboration", "name": "K", "roles": [{ "id": "r", "name": "r" }] }] } },
  { "name": "dependency from a part", "expect": { "code": "INVALID_DEPENDENCY", "path": "/relationships/0/from" },
    "doc": { "kind": "composite-structure", "elements": [{ "id": "c", "type": "class", "name": "C", "parts": [{ "id": "a", "name": "a" }] }, { "id": "d", "type": "class", "name": "D" }], "relationships": [{ "type": "dependency", "from": "a", "to": "d" }] } },
  { "name": "dependency to itself", "expect": { "code": "SELF_CONNECTION", "path": "/relationships/0/to" },
