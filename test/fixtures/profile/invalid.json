[
  { "name": "duplicate element ID", "expect": { "code": "DUPLICATE_ID", "path": "/elements/1/id" },
    "doc": { "kind": "profile", "elements": [{ "id": "a", "type": "metaclass", "name": "Class" }, { "id": "a", "type": "stereotype", "name": "S" }] } },
  { "name": "unknown extension target", "expect": { "code": "MISSING_REFERENCE", "path": "/relationships/0/to" },
    "doc": { "kind": "profile", "elements": [{ "id": "s", "type": "stereotype", "name": "S" }], "relationships": [{ "type": "extension", "from": "s", "to": "ghost" }] } },
  { "name": "unknown profile member", "expect": { "code": "MISSING_REFERENCE", "path": "/elements/0/members/0" },
    "doc": { "kind": "profile", "elements": [{ "id": "p", "type": "profile", "name": "P", "members": ["ghost"] }] } },
  { "name": "extension from a metaclass", "expect": { "code": "INVALID_EXTENSION", "path": "/relationships/0/from" },
    "doc": { "kind": "profile", "elements": [{ "id": "m", "type": "metaclass", "name": "Class" }, { "id": "n", "type": "metaclass", "name": "Component" }], "relationships": [{ "type": "extension", "from": "m", "to": "n" }] } },
  { "name": "extension from a class", "expect": { "code": "INVALID_EXTENSION", "path": "/relationships/0/from" },
    "doc": { "kind": "profile", "elements": [{ "id": "c", "type": "class", "name": "C" }, { "id": "m", "type": "metaclass", "name": "Class" }], "relationships": [{ "type": "extension", "from": "c", "to": "m" }] } },
  { "name": "extension to a stereotype", "expect": { "code": "INVALID_EXTENSION", "path": "/relationships/0/to" },
    "doc": { "kind": "profile", "elements": [{ "id": "s", "type": "stereotype", "name": "S" }, { "id": "t", "type": "stereotype", "name": "T" }], "relationships": [{ "type": "extension", "from": "s", "to": "t" }] } },
  { "name": "stereotype specializing a metaclass", "expect": { "code": "INVALID_GENERALIZATION", "path": "/relationships/0/to" },
    "doc": { "kind": "profile", "elements": [{ "id": "s", "type": "stereotype", "name": "S" }, { "id": "m", "type": "metaclass", "name": "Class" }], "relationships": [{ "type": "generalization", "from": "s", "to": "m" }] } },
  { "name": "generalization between metaclasses", "expect": { "code": "INVALID_GENERALIZATION", "path": "/relationships/0/from" },
    "doc": { "kind": "profile", "elements": [{ "id": "m", "type": "metaclass", "name": "Class" }, { "id": "n", "type": "metaclass", "name": "Classifier" }], "relationships": [{ "type": "generalization", "from": "m", "to": "n" }] } },
  { "name": "generalization cycle", "expect": { "code": "INHERITANCE_CYCLE", "path": "/relationships/1" },
    "doc": { "kind": "profile", "elements": [{ "id": "s", "type": "stereotype", "name": "S" }, { "id": "t", "type": "stereotype", "name": "T" }],
      "relationships": [{ "type": "generalization", "from": "s", "to": "t" }, { "type": "generalization", "from": "t", "to": "s" }] } },
  { "name": "stereotype specializing itself", "expect": { "code": "INHERITANCE_CYCLE", "path": "/relationships/0" },
    "doc": { "kind": "profile", "elements": [{ "id": "s", "type": "stereotype", "name": "S" }], "relationships": [{ "type": "generalization", "from": "s", "to": "s" }] } },
  { "name": "profile applied by a stereotype", "expect": { "code": "INVALID_APPLICATION", "path": "/relationships/0/from" },
    "doc": { "kind": "profile", "elements": [{ "id": "s", "type": "stereotype", "name": "S" }, { "id": "p", "type": "profile", "name": "P" }], "relationships": [{ "type": "apply", "from": "s", "to": "p" }] } },
  { "name": "applying a plain package", "expect": { "code": "INVALID_APPLICATION", "path": "/relationships/0/to" },
    "doc": { "kind": "profile", "elements": [{ "id": "a", "type": "package", "name": "A" }, { "id": "b", "type": "package", "name": "B" }], "relationships": [{ "type": "apply", "from": "a", "to": "b" }] } },
  { "name": "profile applying itself", "expect": { "code": "INVALID_APPLICATION", "path": "/relationships/0/to" },
    "doc": { "kind": "profile", "elements": [{ "id": "p", "type": "profile", "name": "P" }], "relationships": [{ "type": "apply", "from": "p", "to": "p" }] } },
  { "name": "metaclass reference from a package", "expect": { "code": "INVALID_REFERENCE", "path": "/relationships/0/from" },
    "doc": { "kind": "profile", "elements": [{ "id": "a", "type": "package", "name": "A" }, { "id": "m", "type": "metaclass", "name": "Class" }], "relationships": [{ "type": "reference", "from": "a", "to": "m" }] } },
  { "name": "metaclass reference to a stereotype", "expect": { "code": "INVALID_REFERENCE", "path": "/relationships/0/to" },
    "doc": { "kind": "profile", "elements": [{ "id": "p", "type": "profile", "name": "P" }, { "id": "s", "type": "stereotype", "name": "S" }], "relationships": [{ "type": "reference", "from": "p", "to": "s" }] } },
  { "name": "stereotype owned by a plain package", "expect": { "code": "STEREOTYPE_OUTSIDE_PROFILE", "path": "/elements/0/members/0" },
    "doc": { "kind": "profile", "elements": [{ "id": "a", "type": "package", "name": "A", "members": ["s"] }, { "id": "s", "type": "stereotype", "name": "S" }] } },
  { "name": "stereotype in two profiles", "expect": { "code": "MULTIPLE_OWNERS", "path": "/elements/1/members/0" },
    "doc": { "kind": "profile", "elements": [{ "id": "p", "type": "profile", "name": "P", "members": ["s"] }, { "id": "q", "type": "profile", "name": "Q", "members": ["s"] }, { "id": "s", "type": "stereotype", "name": "S" }] } },
  { "name": "nesting cycle", "expect": { "code": "CONTAINMENT_CYCLE", "path": "/elements/1/members/0" },
    "doc": { "kind": "profile", "elements": [{ "id": "p", "type": "profile", "name": "P", "members": ["a"] }, { "id": "a", "type": "package", "name": "A", "members": ["p"] }] } },
  { "name": "reference to a metaclass the profile already owns", "expect": { "code": "RELATIONSHIP_WITH_OWN_MEMBER", "path": "/relationships/0" },
    "doc": { "kind": "profile", "elements": [{ "id": "p", "type": "profile", "name": "P", "members": ["m"] }, { "id": "m", "type": "metaclass", "name": "Class" }], "relationships": [{ "type": "reference", "from": "p", "to": "m" }] } },
  { "name": "nested package applying its owner profile", "expect": { "code": "RELATIONSHIP_WITH_OWN_MEMBER", "path": "/relationships/0" },
    "doc": { "kind": "profile", "elements": [{ "id": "p", "type": "profile", "name": "P", "members": ["a"] }, { "id": "a", "type": "package", "name": "A" }], "relationships": [{ "type": "apply", "from": "a", "to": "p" }] } },
  { "name": "duplicate extension", "expect": { "code": "DUPLICATE_RELATIONSHIP", "path": "/relationships/1" },
    "doc": { "kind": "profile", "elements": [{ "id": "s", "type": "stereotype", "name": "S" }, { "id": "m", "type": "metaclass", "name": "Class" }],
      "relationships": [{ "type": "extension", "from": "s", "to": "m" }, { "type": "extension", "from": "s", "to": "m", "required": true }] } },
  { "name": "tagged value defined twice", "expect": { "code": "DUPLICATE_MEMBER", "path": "/elements/0/attributes/1/name" },
    "doc": { "kind": "profile", "elements": [{ "id": "s", "type": "stereotype", "name": "S", "attributes": [{ "name": "x" }, { "name": "x", "type": "Integer" }] }] } },
  { "name": "tagged value multiplicity with lower above upper", "expect": { "code": "INVALID_MULTIPLICITY", "path": "/elements/0/attributes/0/multiplicity" },
    "doc": { "kind": "profile", "elements": [{ "id": "s", "type": "stereotype", "name": "S", "attributes": [{ "name": "x", "multiplicity": "3..1" }] }] } },
  { "name": "enumeration literal twice", "expect": { "code": "DUPLICATE_MEMBER", "path": "/elements/0/literals/1" },
    "doc": { "kind": "profile", "elements": [{ "id": "e", "type": "enumeration", "name": "E", "literals": ["a", "a"] }] } },
  { "name": "note in a relationship", "expect": { "code": "NOTE_IN_RELATIONSHIP", "path": "/relationships/0/to" },
    "doc": { "kind": "profile", "elements": [{ "id": "s", "type": "stereotype", "name": "S" }, { "id": "n", "type": "note", "text": "x" }], "relationships": [{ "type": "extension", "from": "s", "to": "n" }] } },
  { "name": "note attached to a note", "expect": { "code": "INVALID_ATTACHMENT", "path": "/elements/1/attachedTo/0" },
    "doc": { "kind": "profile", "elements": [{ "id": "n1", "type": "note", "text": "x" }, { "id": "n2", "type": "note", "text": "y", "attachedTo": ["n1"] }] } },
  { "name": "required on a generalization", "expect": { "code": "SCHEMA_INVALID", "path": "/relationships/0/required" },
    "doc": { "kind": "profile", "elements": [{ "id": "s", "type": "stereotype", "name": "S" }, { "id": "t", "type": "stereotype", "name": "T" }], "relationships": [{ "type": "generalization", "from": "s", "to": "t", "required": true }] } },
  { "name": "attributes on a metaclass", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/attributes" },
    "doc": { "kind": "profile", "elements": [{ "id": "m", "type": "metaclass", "name": "Class", "attributes": [] }] } },
  { "name": "members on a stereotype", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/members" },
    "doc": { "kind": "profile", "elements": [{ "id": "s", "type": "stereotype", "name": "S", "members": [] }] } },
  { "name": "unsupported relationship type", "expect": { "code": "SCHEMA_INVALID", "path": "/relationships/0/type" },
    "doc": { "kind": "profile", "elements": [{ "id": "s", "type": "stereotype", "name": "S" }, { "id": "m", "type": "metaclass", "name": "Class" }], "relationships": [{ "type": "association", "from": "s", "to": "m" }] } },
  { "name": "blank stereotype name", "expect": { "code": "INVALID_TEXT", "path": "/elements/0/name" },
    "doc": { "kind": "profile", "elements": [{ "id": "s", "type": "stereotype", "name": "\u00a0 " }] } }
]
