{
  "kind": "package",
  "title": "App layers",
  "elements": [
    { "id": "ui", "type": "package", "name": "ui", "members": ["Controller"] },
    { "id": "domain", "type": "package", "name": "domain", "members": ["order", "ui"] },
    { "id": "order", "type": "class", "name": "Order", "attributes": [{ "name": "id" }] },
    { "id": "infra", "type": "package", "name": "infrastructure", "members": ["order"] }
