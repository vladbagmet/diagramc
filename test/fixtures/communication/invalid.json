[
  { "name": "duplicate lifeline ID", "expect": { "code": "DUPLICATE_ID", "path": "/lifelines/1/id" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "a", "name": "b" }] } },
  { "name": "message ID clashes with a lifeline", "expect": { "code": "DUPLICATE_ID", "path": "/messages/0/id" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "id": "a", "sequence": "1", "from": "a", "to": "b", "name": "m" }] } },
  { "name": "link to an unknown lifeline", "expect": { "code": "MISSING_REFERENCE", "path": "/links/0/to" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }], "links": [{ "from": "a", "to": "nope" }] } },
  { "name": "message from an unknown lifeline", "expect": { "code": "MISSING_REFERENCE", "path": "/messages/0/from" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }], "messages": [{ "sequence": "1", "from": "nope", "to": "a", "name": "m" }] } },
  { "name": "lifeline without name and type", "expect": { "code": "LIFELINE_WITHOUT_NAME", "path": "/lifelines/0" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a" }] } },
  { "name": "selector without a name", "expect": { "code": "SELECTOR_WITHOUT_NAME", "path": "/lifelines/0/selector" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "type": "Worker", "selector": "k" }] } },
  { "name": "two links between the same pair (either direction)", "expect": { "code": "DUPLICATE_LINK", "path": "/links/1" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }, { "from": "b", "to": "a" }] } },
  { "name": "message between unlinked lifelines", "expect": { "code": "MESSAGE_WITHOUT_LINK", "path": "/messages/0/to" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }, { "id": "c", "name": "c" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1", "from": "a", "to": "c", "name": "m" }] } },
  { "name": "self-message without a self-link", "expect": { "code": "MESSAGE_WITHOUT_LINK", "path": "/messages/1/to" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1", "from": "a", "to": "b", "name": "m" }, { "sequence": "1.1", "from": "b", "to": "b", "name": "self" }] } },
  { "name": "return value on a call", "expect": { "code": "INVALID_RETURN_VALUE", "path": "/messages/0/returnValue" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1", "from": "a", "to": "b", "name": "m", "returnValue": "x" }] } },
  { "name": "assignment from an asynchronous signal", "expect": { "code": "INVALID_ASSIGNMENT", "path": "/messages/0/assignTo" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1", "from": "a", "to": "b", "name": "m", "assignTo": "x", "sort": "asynchronous" }] } },
  { "name": "guard and iteration on one message", "expect": { "code": "GUARD_WITH_ITERATION", "path": "/messages/0/iteration" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1", "from": "a", "to": "b", "name": "m", "guard": "x", "iteration": "i=1..n" }] } },
  { "name": "sequence number starting at zero", "expect": { "code": "INVALID_SEQUENCE_NUMBER", "path": "/messages/0/sequence" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "0", "from": "a", "to": "b", "name": "m" }] } },
  { "name": "sequence number with an empty term", "expect": { "code": "INVALID_SEQUENCE_NUMBER", "path": "/messages/0/sequence" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1..2", "from": "a", "to": "b", "name": "m" }] } },
  { "name": "sequence number with an uppercase thread", "expect": { "code": "INVALID_SEQUENCE_NUMBER", "path": "/messages/0/sequence" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1A", "from": "a", "to": "b", "name": "m" }] } },
  { "name": "duplicate sequence number", "expect": { "code": "DUPLICATE_SEQUENCE_NUMBER", "path": "/messages/1/sequence" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1", "from": "a", "to": "b", "name": "m" }, { "sequence": "1", "from": "a", "to": "b", "name": "n" }] } },
  { "name": "nested message without its parent", "expect": { "code": "MISSING_PARENT_MESSAGE", "path": "/messages/1/sequence" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1", "from": "a", "to": "b", "name": "m" }, { "sequence": "2.1", "from": "b", "to": "a", "name": "n" }] } },
  { "name": "nested message not sent by the receiver of its parent", "expect": { "code": "NESTED_SENDER_MISMATCH", "path": "/messages/1/from" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }, { "id": "c", "name": "c" }], "links": [{ "from": "a", "to": "b" }, { "from": "a", "to": "c" }],
      "messages": [{ "sequence": "1", "from": "a", "to": "b", "name": "m" }, { "sequence": "1.1", "from": "a", "to": "c", "name": "n" }] } },
  { "name": "top-level reply", "expect": { "code": "INVALID_REPLY", "path": "/messages/0/sort" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1", "from": "a", "to": "b", "name": "m", "sort": "reply" }] } },
  { "name": "reply to someone other than the caller", "expect": { "code": "INVALID_REPLY", "path": "/messages/1/sort" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }, { "id": "c", "name": "c" }], "links": [{ "from": "a", "to": "b" }, { "from": "b", "to": "c" }],
      "messages": [{ "sequence": "1", "from": "a", "to": "b", "name": "m" }, { "sequence": "1.1", "from": "b", "to": "c", "name": "m", "sort": "reply" }] } },
  { "name": "reply to an asynchronous signal", "expect": { "code": "INVALID_REPLY", "path": "/messages/1/sort" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1", "from": "a", "to": "b", "name": "m", "sort": "asynchronous" }, { "sequence": "1.1", "from": "b", "to": "a", "name": "m", "sort": "reply" }] } },
  { "name": "gap in sibling numbers", "expect": { "code": "SEQUENCE_GAP", "path": "/messages/1/sequence" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1", "from": "a", "to": "b", "name": "m" }, { "sequence": "3", "from": "a", "to": "b", "name": "n" }] } },
  { "name": "gap in thread letters", "expect": { "code": "SEQUENCE_GAP", "path": "/messages/1/sequence" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1a", "from": "a", "to": "b", "name": "m" }, { "sequence": "1c", "from": "a", "to": "b", "name": "n" }] } },
  { "name": "step both with and without thread letters", "expect": { "code": "AMBIGUOUS_THREAD", "path": "/messages/0/sequence" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1", "from": "a", "to": "b", "name": "m" }, { "sequence": "1a", "from": "a", "to": "b", "name": "n" }] } },
  { "name": "unknown property on a lifeline", "expect": { "code": "SCHEMA_INVALID", "path": "/lifelines/0/stereotype" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a", "stereotype": "x" }] } },
  { "name": "unknown message sort", "expect": { "code": "SCHEMA_INVALID", "path": "/messages/0/sort" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1", "from": "a", "to": "b", "name": "m", "sort": "create" }] } },
  { "name": "parallel without an iteration clause", "expect": { "code": "SCHEMA_INVALID", "path": "/messages/0/iteration" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1", "from": "a", "to": "b", "name": "m", "parallel": true }] } },
  { "name": "message without a sequence number", "expect": { "code": "SCHEMA_INVALID", "path": "/messages/0/sequence" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "from": "a", "to": "b", "name": "m" }] } },
  { "name": "missing lifelines", "expect": { "code": "SCHEMA_INVALID", "path": "/lifelines" },
    "doc": { "kind": "communication" } },
  { "name": "multi-line message name", "expect": { "code": "SCHEMA_INVALID", "path": "/messages/0/name" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "a" }, { "id": "b", "name": "b" }], "links": [{ "from": "a", "to": "b" }],
      "messages": [{ "sequence": "1", "from": "a", "to": "b", "name": "line\nbreak" }] } },
  { "name": "blank lifeline name", "expect": { "code": "INVALID_TEXT", "path": "/lifelines/0/name" },
    "doc": { "kind": "communication", "lifelines": [{ "id": "a", "name": "   " }] } }
]
