[
  { "name": "duplicate element ID", "expect": { "code": "DUPLICATE_ID", "path": "/elements/1/id" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }, { "id": "a", "type": "class", "name": "B" }] } },
  { "name": "relationship ID clashes with an element ID", "expect": { "code": "DUPLICATE_ID", "path": "/relationships/0/id" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }], "relationships": [{ "id": "a", "type": "association", "from": "a", "to": "a" }] } },
  { "name": "unknown relationship target", "expect": { "code": "MISSING_REFERENCE", "path": "/relationships/0/to" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }], "relationships": [{ "type": "association", "from": "a", "to": "missing" }] } },
  { "name": "unknown note attachment", "expect": { "code": "MISSING_REFERENCE", "path": "/elements/1/attachedTo/0" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }, { "id": "n", "type": "note", "text": "x", "attachedTo": ["nope"] }] } },
  { "name": "note attached to a note", "expect": { "code": "INVALID_ATTACHMENT", "path": "/elements/1/attachedTo/0" },
    "doc": { "kind": "class", "elements": [{ "id": "n1", "type": "note", "text": "x" }, { "id": "n2", "type": "note", "text": "y", "attachedTo": ["n1"] }] } },
  { "name": "generalization cycle", "expect": { "code": "INHERITANCE_CYCLE", "path": "/relationships/1" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }, { "id": "b", "type": "class", "name": "B" }], "relationships": [{ "type": "generalization", "from": "a", "to": "b" }, { "type": "generalization", "from": "b", "to": "a" }] } },
  { "name": "self generalization", "expect": { "code": "INHERITANCE_CYCLE", "path": "/relationships/0" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }], "relationships": [{ "type": "generalization", "from": "a", "to": "a" }] } },
  { "name": "class specializes an interface", "expect": { "code": "INVALID_GENERALIZATION", "path": "/relationships/0/to" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }, { "id": "i", "type": "interface", "name": "I" }], "relationships": [{ "type": "generalization", "from": "a", "to": "i" }] } },
  { "name": "interface specializes a class", "expect": { "code": "INVALID_GENERALIZATION", "path": "/relationships/0/to" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }, { "id": "i", "type": "interface", "name": "I" }], "relationships": [{ "type": "generalization", "from": "i", "to": "a" }] } },
  { "name": "realization of a class", "expect": { "code": "INVALID_REALIZATION", "path": "/relationships/0/to" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }, { "id": "b", "type": "class", "name": "B" }], "relationships": [{ "type": "realization", "from": "a", "to": "b" }] } },
  { "name": "interface realizes an interface", "expect": { "code": "INVALID_REALIZATION", "path": "/relationships/0/from" },
    "doc": { "kind": "class", "elements": [{ "id": "i", "type": "interface", "name": "I" }, { "id": "j", "type": "interface", "name": "J" }], "relationships": [{ "type": "realization", "from": "i", "to": "j" }] } },
  { "name": "relationship from a note", "expect": { "code": "NOTE_IN_RELATIONSHIP", "path": "/relationships/0/from" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }, { "id": "n", "type": "note", "text": "x" }], "relationships": [{ "type": "association", "from": "n", "to": "a" }] } },
  { "name": "multiplicity lower above upper", "expect": { "code": "INVALID_MULTIPLICITY", "path": "/relationships/0/toEnd/multiplicity" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }], "relationships": [{ "type": "association", "from": "a", "to": "a", "toEnd": { "multiplicity": "3..1" } }] } },
  { "name": "star as lower bound", "expect": { "code": "INVALID_MULTIPLICITY", "path": "/elements/0/attributes/0/multiplicity" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A", "attributes": [{ "name": "x", "multiplicity": "*..2" }] }] } },
  { "name": "upper bound zero", "expect": { "code": "INVALID_MULTIPLICITY", "path": "/elements/0/operations/0/parameters/0/multiplicity" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A", "operations": [{ "name": "f", "parameters": [{ "name": "p", "multiplicity": "0" }] }] }] } },
  { "name": "part shared by many composites", "expect": { "code": "INVALID_COMPOSITION", "path": "/relationships/0/fromEnd/multiplicity" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }, { "id": "b", "type": "class", "name": "B" }], "relationships": [{ "type": "composition", "from": "a", "to": "b", "fromEnd": { "multiplicity": "0..*" } }] } },
  { "name": "navigability on the diamond end", "expect": { "code": "INVALID_NAVIGABILITY", "path": "/relationships/0/fromEnd/navigable" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }, { "id": "b", "type": "class", "name": "B" }], "relationships": [{ "type": "aggregation", "from": "a", "to": "b", "fromEnd": { "navigable": true } }] } },
  { "name": "duplicate attribute", "expect": { "code": "DUPLICATE_MEMBER", "path": "/elements/0/attributes/1/name" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A", "attributes": [{ "name": "x" }, { "name": "x", "type": "T" }] }] } },
  { "name": "duplicate literal", "expect": { "code": "DUPLICATE_MEMBER", "path": "/elements/0/literals/1" },
    "doc": { "kind": "class", "elements": [{ "id": "e", "type": "enumeration", "name": "E", "literals": ["A", "A"] }] } },
  { "name": "abstract operation in a concrete class", "expect": { "code": "ABSTRACT_OPERATION_IN_CONCRETE_CLASS", "path": "/elements/0/operations/0/abstract" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A", "operations": [{ "name": "f", "abstract": true }] }] } },
  { "name": "duplicate generalization", "expect": { "code": "DUPLICATE_RELATIONSHIP", "path": "/relationships/1" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }, { "id": "b", "type": "class", "name": "B" }], "relationships": [{ "type": "generalization", "from": "a", "to": "b" }, { "type": "generalization", "from": "a", "to": "b" }] } },
  { "name": "containment cycle", "expect": { "code": "CONTAINMENT_CYCLE", "path": "/relationships/1" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }, { "id": "b", "type": "class", "name": "B" }], "relationships": [{ "type": "containment", "from": "a", "to": "b" }, { "type": "containment", "from": "b", "to": "a" }] } },
  { "name": "nested in two owners", "expect": { "code": "MULTIPLE_OWNERS", "path": "/relationships/1/to" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }, { "id": "b", "type": "class", "name": "B" }, { "id": "c", "type": "class", "name": "C" }], "relationships": [{ "type": "containment", "from": "a", "to": "c" }, { "type": "containment", "from": "b", "to": "c" }] } },
  { "name": "unknown element property", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/color" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A", "color": "red" }] } },
  { "name": "literals on a class", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/literals" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A", "literals": ["X"] }] } },
  { "name": "keyword on an association", "expect": { "code": "SCHEMA_INVALID", "path": "/relationships/0/keyword" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }], "relationships": [{ "type": "association", "from": "a", "to": "a", "keyword": "use" }] } },
  { "name": "ends on a dependency", "expect": { "code": "SCHEMA_INVALID", "path": "/relationships/0/toEnd" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }], "relationships": [{ "type": "dependency", "from": "a", "to": "a", "toEnd": { "navigable": true } }] } },
  { "name": "multiplicity that is not a range", "expect": { "code": "SCHEMA_INVALID", "path": "/relationships/0/toEnd/multiplicity" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }], "relationships": [{ "type": "association", "from": "a", "to": "a", "toEnd": { "multiplicity": "many" } }] } },
  { "name": "unknown relationship type", "expect": { "code": "SCHEMA_INVALID", "path": "/relationships/0" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A" }], "relationships": [{ "type": "inheritance", "from": "a", "to": "a" }] } },
  { "name": "missing elements", "expect": { "code": "SCHEMA_INVALID", "path": "/elements" },
    "doc": { "kind": "class" } },
  { "name": "multi-line name", "expect": { "code": "SCHEMA_INVALID", "path": "/elements/0/name" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A\n@enduml" }] } },
  { "name": "bidi override in a name", "expect": { "code": "INVALID_TEXT", "path": "/elements/0/name" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "‮Evil" }] } },
  { "name": "blank attribute type", "expect": { "code": "INVALID_TEXT", "path": "/elements/0/attributes/0/type" },
    "doc": { "kind": "class", "elements": [{ "id": "a", "type": "class", "name": "A", "attributes": [{ "name": "x", "type": "   " }] }] } },
  { "name": "unknown kind", "expect": { "code": "UNKNOWN_KIND", "path": "/kind" },
    "doc": { "kind": "klass", "elements": [] } }
]
