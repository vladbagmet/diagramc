{
  "name": "diagramc",
  "version": "1.1.1",
  "private": true,
  "description": "Compile validated JSON models into clean UML diagrams. Built for AI agents, offline, with PlantUML and Mermaid export and import.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladbagmet/diagramc.git"
  },
  "bugs": {
    "url": "https://github.com/vladbagmet/diagramc/issues"
  },
  "homepage": "https://github.com/vladbagmet/diagramc#readme",
  "type": "module",
  "bin": {
    "diagramc": "dist/cli.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "schema/",
    "assets/fonts/",
    "scripts/setup-renderer.mjs",
    "examples/",
    "skills/",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node scripts/finish-build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,mjs,js}\"",
    "format:check": "prettier --check \"**/*.{ts,mjs,js}\"",
    "prepack": "npm run build",
    "setup:renderer": "node scripts/setup-renderer.mjs",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:coverage": "npm run build && node --enable-source-maps --test --experimental-test-coverage --test-reporter=spec \"--test-coverage-include=dist/**\" \"--test-coverage-include=src/**\" \"--test-coverage-exclude=src/types/**\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 \"test/*.test.mjs\"",
    "test:integration": "npm run build && node --test \"test/integration/*.test.mjs\"",
    "gallery": "npm run build && node scripts/gallery.mjs",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "release:check": "node scripts/release-check.mjs",
    "render:example": "node dist/cli.js render examples/class/ordering.json -o artifacts/gallery/example.svg",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test:coverage && npm run gallery"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@resvg/resvg-js": "2.6.2",
    "ajv": "8.20.0",
    "elkjs": "0.12.0",
    "harfbuzzjs": "1.6.3",
    "subset-font": "2.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
