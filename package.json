{
  "name": "agent-uml-cli",
  "version": "1.0.0",
  "private": true,
  "description": "Agent-first CLI: validated JSON UML models to SVG/PNG, offline",
  "type": "module",
  "bin": {
    "uml": "dist/cli.js"
  },
  "files": [
    "dist/",
    "!dist/**/*.map",
    "schema/",
    "assets/fonts/",
    "scripts/setup-renderer.mjs",
    "examples/",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc && node scripts/finish-build.mjs",
    "prepack": "npm run build",
    "setup:renderer": "node scripts/setup-renderer.mjs",
    "test": "npm run build && node --test \"test/*.test.mjs\"",
    "test:coverage": "npm run build && node --enable-source-maps --test --experimental-test-coverage \"--test-coverage-include=dist/**\" \"--test-coverage-include=src/**\" \"--test-coverage-exclude=src/types/**\" --test-coverage-lines=90 --test-coverage-branches=80 --test-coverage-functions=90 \"test/*.test.mjs\"",
    "test:integration": "npm run build && node --test \"test/integration/*.test.mjs\"",
    "gallery": "npm run build && node scripts/gallery.mjs",
    "render:example": "node dist/cli.js render examples/class/ordering.json -o artifacts/gallery/example.svg"
  },
  "dependencies": {
    "@resvg/resvg-js": "2.6.2",
    "ajv": "8.20.0",
    "elkjs": "0.11.1",
    "harfbuzzjs": "1.6.2",
    "subset-font": "2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  }
}
