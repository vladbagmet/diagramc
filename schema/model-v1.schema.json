{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-uml.invalid/schema/model-v1.schema.json",
  "title": "UML class model v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["classes", "relationships"],
  "properties": {
    "classes": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "$ref": "#/definitions/name" },
          "attributes": { "$ref": "#/definitions/members" },
          "methods": { "$ref": "#/definitions/members" }
        }
      }
    },
    "relationships": {
      "type": "array", "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["type", "from", "to"],
        "properties": {
          "type": { "enum": ["association", "inheritance"] },
          "from": { "$ref": "#/definitions/id" },
          "to": { "$ref": "#/definitions/id" },
          "label": { "$ref": "#/definitions/text" }
        }
      }
    }
  },
  "definitions": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}(?![\\s\\S])" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ufffe\\uffff]+(?![\\s\\S])" },
    "text": { "type": "string", "minLength": 1, "maxLength": 180, "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u2028\\u2029\\ufffe\\uffff]+(?![\\s\\S])" },
    "members": { "type": "array", "maxItems": 20, "items": { "$ref": "#/definitions/text" } }
  }
}
